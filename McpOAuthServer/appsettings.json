{
  "oAuthServerSettings": {
    "issuer": "https://auth.example.com",
    "signingKeyPath": "Data/signing-key.pem",
    "supportedScopes": [ "memories", "openid", "email" ],
    "allowedResources": [ "[[MCP_RESOURCE_IDENTIFIER]]" ],
    "allowedRedirectUriPrefixes": [ "https://chatgpt.com/", "http://127.0.0.1", "http://localhost" ],
    "authorisationCodeLifetimeSeconds": 60,
    "accessTokenLifetimeSeconds": 3600,
    "idTokenLifetimeSeconds": 3600,
    "refreshTokenLifetimeSeconds": 2592000,
    "passwordHashIterations": 210000,
    "predefinedClients": [],
    "seedUsers": []
  },
  "dataStoreSettings": {
    "authorisationCodesStorePath": "Data/authorisation-codes.json",
    "clientsStorePath": "Data/clients.json",
    "refreshTokensStorePath": "Data/refresh-tokens.json",
    "usersStorePath": "Data/users.json"
  },
  "nuciLoggerSettings": {
    "logFilePath": "logfile.log",
    "isFileOutputEnabled": true
  }
}
